<resources>
    <style name="Theme.Franca" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1A1A1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0E0E10</item>
        <item name="android:navigationBarColor">#0E0E10</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Franca.YapeReview" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/franca_panel_background</item>
        <item name="android:statusBarColor">@color/franca_panel_background</item>
        <item name="android:navigationBarColor">@color/franca_panel_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
